# Crypto City Game - Environment Variables
# Copy this file to .env.local and fill in your values

# PostHog Analytics (Session Replays)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Privy Authentication (Wallet Connect)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Plasma Network Configuration
NEXT_PUBLIC_PLASMA_RPC=https://rpc.plasma.to
PLASMA_RELAYER_CREDENTIAL=your_relayer_credential_here
NEXT_PUBLIC_MERCHANT_ADDRESS=0xYourMerchantAddress

# API Keys
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key_here
NEXT_PUBLIC_PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx
NEXT_PUBLIC_TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
NANOBANANA_API_KEY=your_nanobanana_api_key_here
